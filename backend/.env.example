# ============================================================
#  QSToolkit Backend - Environment Variables
#  Copy this file to .env and fill in all values
#  NEVER commit .env to GitHub!
# ============================================================

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key   # Settings > API > service_role (SECRET)
SUPABASE_ANON_KEY=your-supabase-anon-key              # Settings > API > anon/public

# JWT (generate a long random string: openssl rand -base64 64)
JWT_SECRET=your-very-long-random-secret-key-here
JWT_EXPIRES_IN=7d

# Mailjet (Email)
MAILJET_API_KEY=your-mailjet-api-key                 # Mailjet > Account Settings > API Keys
MAILJET_API_SECRET=your-mailjet-api-secret
MAILJET_SENDER_EMAIL=noreply@qstoolkit.com
MAILJET_SENDER_NAME=QSToolkit

# Paystack (Nigerian Payments) — kept as legacy fallback
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx       # test: sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# Flutterwave (Primary Payment Gateway)
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxx-x   # test: FLWSECK-TEST-xxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxx-x
FLUTTERWAVE_SECRET_HASH=your-webhook-secret-hash

# Zeptomail (Primary Email)
ZEPTOMAIL_API_KEY=your-zeptomail-api-key
ZEPTOMAIL_SENDER_EMAIL=noreply@qstoolkit.com
ZEPTOMAIL_SENDER_NAME=QSToolkit

# Cloudinary (optional - for logo/signature storage, or use Supabase Storage)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# AI Services (Free tiers available)
GEMINI_API_KEY=your-gemini-api-key                # https://aistudio.google.com/app/apikey
JINA_API_KEY=your-jina-api-key                    # Optional — https://jina.ai/embeddings
OPENROUTER_API_KEY=your-openrouter-key            # Optional fallback — https://openrouter.ai

# Environment
STAGING=false

# Sentry (crash reporting)
SENTRY_DSN=https://xxxxx@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# PostHog (analytics)
POSTHOG_API_KEY=phc_xxxxx
POSTHOG_HOST=https://app.posthog.com

# Production only
# DATABASE_URL=postgresql://...  (Supabase connection string if direct DB needed)
